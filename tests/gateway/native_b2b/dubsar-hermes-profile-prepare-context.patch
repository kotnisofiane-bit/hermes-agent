+
+def prepare_context(runtime: RuntimeAdapter, *, execution: Any) -> dict[str, Any]:
+    """Bounded admission preparation for one bound execution.
+
+    Stamps the source configuration into ``bound``, builds the native view
+    once, and returns a revalidation closure the admission boundary calls
+    before trusting the preparation. Nothing is published and no context
+    recheck is registered here: publication stays with ``bound_context``.
+    """
+    host = _host()
+    if host.current_execution() is not execution:
+        raise ConfigError("b2b_capability")
+    entry = execution.policy_get("project")
+    bound = RuntimeAdapter.for_bound_execution(runtime, execution, entry)
+    stamp = bound._bound_stamp
+
+    def validate_configuration() -> bool:
+        # A changed source configuration yields a changed stamp: answer
+        # False so the caller classifies the drift as policy-changed; a
+        # bind failure still raises and classifies as context_unavailable.
+        fresh = RuntimeAdapter.for_bound_execution(runtime, execution, entry)
+        return fresh._bound_stamp == stamp
+
+    view, rendered = build_agent_context_view_v2(
+        bound, preserve_native_oc_receipt=True,
+        include_automation_results=bound._bound_include_automation_results)
+    validate_configuration()
+    return {"view": view, "rendered": rendered,
+            "validate_configuration": validate_configuration}
